+  DEBUG_PRINT=0
+  PICO_WS_SERVER_USE_CYW43=$<BOOL:${PICO_WS_SERVER_USE_CYW43}>
+)
 
 target_link_libraries(pico_ws_server
   pico_stdlib
-  pico_cyw43_driver
-  pico_lwip_nosys
   pico_mbedtls
   lwipopts_provider
 )
 
