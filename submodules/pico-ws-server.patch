diff --git a/CMakeLists.txt b/CMakeLists.txt
index cef4fba..e640e85 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,12 @@ set(STATIC_HTML_FILENAME "" CACHE PATH "Filename of static HTML file" PARENT_SCO
 mark_as_advanced(STATIC_HTML_PATH)
