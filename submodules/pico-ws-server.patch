+#ifndef PICO_WS_SERVER_USE_CYW43
+#define PICO_WS_SERVER_USE_CYW43 1
+#endif
+
+#if PICO_WS_SERVER_USE_CYW43
+
 #include "cyw43_config.h"
 
 // RAII-style wrapper for cyw43 thread enter/exit.
@@ -14,4 +20,21 @@ class Cyw43Guard {
   }
 };
 
+#else
+
+#ifndef cyw43_arch_lwip_check
+#define cyw43_arch_lwip_check() ((void)0)
+#endif
+
+class Cyw43Guard {
+  public:
+    Cyw43Guard() = default;
+    ~Cyw43Guard() = default;
+
+    Cyw43Guard(const Cyw43Guard&) = delete;
+    Cyw43Guard& operator=(const Cyw43Guard&) = delete;
+};
+
+#endif
+
 #endif
