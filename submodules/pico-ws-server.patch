+option(
+  PICO_WS_SERVER_USE_CYW43
+  "Use Pico W CYW43 synchronization"
+  ON
+)
+
 add_library(pico_ws_server
   src/client_connection.cpp
   src/http_handler.cpp
@@ -33,16 +39,24 @@ target_include_directories(pico_ws_server PUBLIC ${CMAKE_CURRENT_LIST_DIR}/inclu
